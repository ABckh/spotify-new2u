# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# Every value below is a placeholder. Do not commit real credentials.

# --- Application ---------------------------------------------------------
# One of: local, staging, production.
APP_ENV=local
# One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Port the API process listens on inside the container.
API_PORT=8000
# Swagger UI at /docs and the schema at /openapi.json, for testing by hand.
# Default (left out): on when APP_ENV=local, off otherwise. true or false.
# API_DOCS_ENABLED=true

# --- Database ------------------------------------------------------------
# SQLAlchemy URL for the synchronous psycopg 3 driver.
# Host is the compose service name when running under docker compose.
DATABASE_URL=postgresql+psycopg://new2u:change-me@postgres:5432/new2u

# Used only by the compose postgres service to initialise the cluster.
# Keep these consistent with DATABASE_URL.
POSTGRES_USER=new2u
POSTGRES_PASSWORD=change-me
POSTGRES_DB=new2u

# --- Secrets -------------------------------------------------------------
# AES-256-GCM key used to encrypt provider refresh tokens at rest (32 bytes, URL-safe base64).
# Generate with: python -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
TOKEN_ENCRYPTION_KEY=
# Key for the hashes under which session tokens and sign-in secrets are stored.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_TOKEN_SECRET=
# Lifetime of a session token we hand to the device, in seconds.
SESSION_TOKEN_TTL_SECONDS=3600
# How long the device stays signed in without opening the app, in seconds
# (90 days; at most 365 days). Each refresh rotates the refresh token and
# starts this time again (POST /auth/refresh).
REFRESH_TOKEN_TTL_SECONDS=7776000

# --- Spotify -------------------------------------------------------------
# Authorization Code with PKCE. The PKCE verifier is always sent.
SPOTIFY_CLIENT_ID=
# Optional. When set, token requests also authenticate with it (confidential
# client). Leave empty for a public client. Never commit a value.
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI registered on the Spotify app, character for character.
# Sent verbatim to Spotify; never rebuilt from the request host.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
# Spotify account IDs that may sign in, comma-separated (spaces are ignored).
# Any other account is refused with account_not_allowed and nothing is stored.
# Empty: any account with APP_ENV=local; no account at all in staging or
# production. Find an ID in the Spotify app: your profile > ... > Share >
# Copy link to profile; the ID is the part after /user/ and before any "?".
# Read at startup: after a change, run `docker compose up -d` (a plain
# `docker compose restart` keeps the old value).
SPOTIFY_ALLOWED_ACCOUNT_IDS=

# --- Sign-in -------------------------------------------------------------
# Seconds the app has to finish a sign-in it started.
OAUTH_LOGIN_TTL_SECONDS=600
# App URL the callback redirects to when sign-in finishes: the iOS app's
# callback scheme, captured by ASWebAuthenticationSession. Gets login_id, result
# and the one-time callback_code the claim needs. A custom scheme only (no
# http/https), no query or fragment. Required unless APP_ENV=local and
# SPOTIFY_REDIRECT_URI is on 127.0.0.1, localhost or ::1.
APP_CALLBACK_URL=
# Abuse limits on the sign-in routes: requests per client IP per minute, and
# sign-ins in progress across all clients (above it, login answers 503).
LOGIN_RATE_LIMIT_PER_MINUTE=10
CLAIM_RATE_LIMIT_PER_MINUTE=60
MAX_PENDING_LOGINS=500
# Read by uvicorn, not the app: the peers whose X-Forwarded-For is believed.
# Set it to the reverse proxy's address as the api container sees it, and to
# nothing broader; never "*". With the wrong value every client shares one
# rate-limit bucket, or any client can choose its own IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Poller --------------------------------------------------------------
# How often the poller asks Spotify for recently played tracks (15 minutes).
# Spotify only returns the last 50 plays, so this must stay well under the time
# it takes a heavy listener to play 50 tracks.
POLLER_INTERVAL_SECONDS=900
# Between those polls, how often the poller looks for a newly connected (or
# reconnected) account and polls it at once instead of waiting for the next one.
POLLER_NEW_CONNECTION_CHECK_SECONDS=15
# How long after the last poll (scheduled or manual) or manual poll request the
# server refuses another manual poll (POST /v1/me/spotify/poll) with 429.
MANUAL_POLL_COOLDOWN_SECONDS=300
# Days before the Spotify grant's 6-month expiry at which reconnect warnings start.
REAUTH_WARNING_DAYS=30
# How often the poller looks for a queued history file import.
HISTORY_IMPORT_CHECK_SECONDS=5
# HISTORY_IMPORT_DIR is set by docker-compose.yml (a volume both services share).

# --- Retention -----------------------------------------------------------
# Days collection records (when we checked Spotify, what we found) are kept.
# The poller deletes older ones on every tick.
COLLECTION_RECORDS_RETENTION_DAYS=90
