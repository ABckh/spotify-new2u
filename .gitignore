# Secrets and local environment
.env
.env.*
!.env.example
# Your own server's deploy inputs. Already covered by .env.*; listed so it stays ignored if that rule changes.
.env.prod
# Notes about your own instance (server address, keys' locations), kept out of git.
*.local.md

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/
# Per-machine agent tool settings: absolute paths, not shareable.
.claude/settings.local.json
