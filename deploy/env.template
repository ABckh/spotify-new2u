# Every setting of the VPS stack and where its value comes from (WHO-175).
# Names only: no value here except for the "fixed" ones, which are not secret.
# scripts/deploy-remote.sh (WHO-176) writes /srv/new2u/.env (mode 0600) from
# this list; tests/test_deploy_files.py fails when a key of .env.example or of
# the settings (src/app/core/config.py) is missing here. See .env.example for what each key means.
#
# Sources:
#   secret   a CI secret (GitHub Actions secret). Never in the repo or a log.
#   input    a deploy input that is not secret (GitHub Actions variable).
#            API_IMAGE is set by the pipeline itself (the commit's image).
#   fixed    always this value on the VPS.
#   compose  set by docker-compose.yml / docker-compose.vps.yml; do not put it in .env.
#   default  optional input; left out, the app's default applies.
#
# NAME                                 SOURCE   FIXED VALUE

# --- read by docker-compose.vps.yml only ---
API_IMAGE                              input
API_HOSTNAME                           input
# A name, an IPv4 address, or an IPv6 address in brackets.
# CADDY_TLS left out: scripts/deploy-remote.sh picks public (a name) or
# public_ip (an IP address); internal only on test targets.
CADDY_TLS                              default
# Set by scripts/deploy-remote.sh from API_HOSTNAME; never an input of its own.
CADDY_DEFAULT_SNI                      default
# Where the database runs (docs/self-hosting.md "External database"). Left out: the postgres
# container on this server. Set: the private address or name of a database
# server of its own (deploy/db-host.sh); api and poller connect over TLS and no
# postgres container runs here.
DATABASE_HOST                          default
# Set by scripts/deploy-remote.sh from DATABASE_HOST: require when it is set.
DATABASE_SSLMODE                       default
# Set by scripts/deploy-remote.sh from DATABASE_HOST: require when it is set
# (SCRAM-SHA-256-PLUS only, WHO-188 F1); empty for the local container.
DATABASE_CHANNEL_BINDING               default
# Set by scripts/deploy-remote.sh from DATABASE_HOST: localdb when it is not set.
COMPOSE_PROFILES                       default

# --- Application ---
APP_ENV                                fixed    production
LOG_LEVEL                              default
API_PORT                               fixed    8000
API_DOCS_ENABLED                       default

# --- Database ---
DATABASE_URL                           compose
POSTGRES_USER                          fixed    new2u
POSTGRES_PASSWORD                      secret
POSTGRES_DB                            fixed    new2u

# --- Secrets ---
TOKEN_ENCRYPTION_KEY                   secret
SESSION_TOKEN_SECRET                   secret
SESSION_TOKEN_TTL_SECONDS              default
REFRESH_TOKEN_TTL_SECONDS              default

# --- Spotify ---
SPOTIFY_CLIENT_ID                      secret
SPOTIFY_CLIENT_SECRET                  secret
# https://<API_HOSTNAME>/auth/spotify/callback, as registered on the Spotify app.
SPOTIFY_REDIRECT_URI                   input
# Account IDs identify a person: kept out of logs like a secret.
SPOTIFY_ALLOWED_ACCOUNT_IDS            secret

# --- Sign-in ---
OAUTH_LOGIN_TTL_SECONDS                default
# The app's custom scheme, e.g. new2u://signed-in.
APP_CALLBACK_URL                       input
LOGIN_RATE_LIMIT_PER_MINUTE            default
CLAIM_RATE_LIMIT_PER_MINUTE            default
MAX_PENDING_LOGINS                     default
# Caddy's fixed address on the compose network.
FORWARDED_ALLOW_IPS                    compose

# --- Reads (in the settings, not in .env.example) ---
READ_RATE_LIMIT_PER_MINUTE             default
EXPORT_RATE_LIMIT_PER_MINUTE           default
EXPORT_IDLE_TIMEOUT_SECONDS            default

# --- Poller ---
POLLER_INTERVAL_SECONDS                default
POLLER_NEW_CONNECTION_CHECK_SECONDS    default
MANUAL_POLL_COOLDOWN_SECONDS           default
REAUTH_WARNING_DAYS                    default
HISTORY_IMPORT_CHECK_SECONDS           default
# The upload volume both api and poller mount (docker-compose.yml, WHO-104).
HISTORY_IMPORT_DIR                     compose

# --- Retention ---
COLLECTION_RECORDS_RETENTION_DAYS      default
